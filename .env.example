# Where site-service is reachable. The compose stack publishes it on loopback:8001.
# Overridable at runtime from the sidebar, so this is only the starting value.
API_BASE_URL=http://localhost:8001

# Seconds a single API call gets before the page gives up on it. Detection and
# explanation are both asynchronous on the backend, so nothing here should ever
# need to be long.
API_TIMEOUT_SECONDS=30

# Presigned uploads go straight to R2 and can be large — a video is the reason this
# is separate from the one above.
UPLOAD_TIMEOUT_SECONDS=300
